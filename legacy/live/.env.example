# Скопируй этот файл в .env (без .example) и впиши свои значения.
# .env НИКОГДА не должен попадать в git — добавь его в .gitignore.

# Приватный ключ кошелька (Polygon). НИКОМУ не показывай, не публикуй.
POLYMARKET_PRIVATE_KEY=

# Тип подписи: 0 = обычный EOA-кошелёк (MetaMask и т.д.)
#              1 = Polymarket proxy-кошелёк email/Magic
#              2 = Gnosis Safe
# Если не уверен — начни с 0 (обычный MetaMask), для встроенного
# Polymarket-кошелька (регистрация по email) скорее всего нужен 1.
POLYMARKET_SIGNATURE_TYPE=0

# Заполняется автоматически после первого запуска `--setup`, не трогай руками
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# --- Предохранители (жёсткие лимиты, независимо от Kelly/fixed расчётов) ---

# Максимальная ставка на ОДНУ сделку в $, что бы ни насчитала стратегия.
TRADING_MAX_STAKE_PER_TRADE=2.0

# Если реализованный убыток за календарный день превышает эту долю
# банкролла — бот останавливает торговлю до следующего дня.
TRADING_MAX_DAILY_LOSS_FRACTION=0.10

# ГЛАВНЫЙ ПРЕДОХРАНИТЕЛЬ: пока true — ордера НЕ отправляются на биржу,
# только логируются "что бы было сделано". Поменяй на false осознанно,
# когда будешь готов торговать по-настоящему.
TRADING_DRY_RUN=true
